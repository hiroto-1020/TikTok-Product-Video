# APIキーなどの秘密情報は、このファイルをコピーした .env（Git 管理外）にだけ書く。
#   cp .env.example .env
# 値を入れた .env は絶対にコミットしない（.gitignore と .githooks/pre-commit で防止済み）。
# どれも任意。空のままでも制作できます。

# HeyGen（HyperFrames の BGM 検索・TTS・クラウドレンダー）
HEYGEN_API_KEY=
# Google Gemini（HyperFrames snapshot --describe / Lyria BGM 生成）
GEMINI_API_KEY=
# Figma（Figma から素材を取り込む場合）
FIGMA_TOKEN=
