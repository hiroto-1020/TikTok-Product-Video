{
  "permissions": {
    "allow": [
      "Bash(bash scripts/*)",
      "Bash(python3 scripts/*)",
      "Bash(node scripts/*)",
      "Bash(npx hyperframes:*)",
      "Bash(npx --no-install hyperframes:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
