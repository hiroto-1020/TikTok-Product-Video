{
  "permissions": {
    "allow": [
      "Bash(bash scripts/*)",
      "Bash(python3 scripts/*)",
      "Bash(node scripts/*)",
      "Bash(npx hyperframes:*)",
      "Bash(npx --no-install hyperframes:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)"
    ],
    "deny": [
      "Bash(git add -f:*)",
      "Bash(git add --force:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
